---
interface Props {
  nodes: readonly string[];
}

const { nodes } = Astro.props;
---

<div class="soft-card rounded-3xl p-5">
  <div class="flex flex-wrap items-center gap-3">
    {
      nodes.map((node, index) => (
        <>
          <div class:list={[
            "min-w-[96px] rounded-2xl border px-3 py-3 text-center text-xs font-extrabold",
            index === 0 && "border-emerald-200 bg-emerald-50 text-emerald-700",
            index === 1 && "border-blue-200 bg-blue-soft text-blue-accent",
            index === 2 && "border-red-200 bg-red-50 text-red-500",
            index === 3 && "border-indigo-200 bg-indigo-50 text-indigo-600",
            index === 4 && "border-slate-200 bg-slate-50 text-ink-700"
          ]}>
            {node}
          </div>
          {index < nodes.length - 1 && <span class="text-blue-accent">→</span>}
        </>
      ))
    }
  </div>
</div>
