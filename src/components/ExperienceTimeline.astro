---
interface Props {
  locale?: "ko" | "en";
  linkHref?: string;
  items: readonly {
    period: string;
    startDate?: string;
    endDate?: string;
    company: string;
    role: string;
    bullets: readonly string[];
  }[];
}

const { items, locale = "ko", linkHref } = Astro.props;

function parseLocalDate(value: string) {
  const [year, month, day] = value.split("-").map(Number);
  return new Date(year, month - 1, day);
}

function getMonthDiff(startDate: string, endDate?: string) {
  const start = parseLocalDate(startDate);
  const end = endDate ? parseLocalDate(endDate) : new Date();
  let months = (end.getFullYear() - start.getFullYear()) * 12 + end.getMonth() - start.getMonth();

  if (end.getDate() < start.getDate()) {
    months -= 1;
  }

  return Math.max(months + 1, 0);
}

function formatDuration(startDate: string | undefined, endDate: string | undefined, currentLocale: "ko" | "en") {
  if (!startDate) {
    return "";
  }

  const totalMonths = getMonthDiff(startDate, endDate);
  const years = Math.floor(totalMonths / 12);
  const months = totalMonths % 12;

  if (currentLocale === "ko") {
    if (years === 0 && months === 0) return "1개월 미만";
    if (years === 0) return `${months}개월`;
    if (months === 0) return `${years}년`;
    return `${years}년 ${months}개월`;
  }

  if (years === 0 && months === 0) return "less than 1 mo";
  if (years === 0) return `${months} mo${months > 1 ? "s" : ""}`;
  if (months === 0) return `${years} yr${years > 1 ? "s" : ""}`;
  return `${years} yr${years > 1 ? "s" : ""} ${months} mo${months > 1 ? "s" : ""}`;
}
---

<div class="grid gap-4">
  {
    items.map((item) => (
      <article
        class:list={[
          "soft-card relative rounded-3xl p-6 sm:p-7",
          linkHref && "transition hover:-translate-y-0.5 hover:border-blue-accent/35 hover:shadow-[0_20px_45px_rgba(15,91,255,0.12)]"
        ]}
      >
        {
          linkHref && (
            <a href={linkHref} class="absolute inset-0 z-10 rounded-3xl" aria-label={`${item.company} experience details`}>
              <span class="sr-only">{item.company} experience details</span>
            </a>
          )
        }
        <div class="grid gap-6 md:grid-cols-[260px_1fr]">
          <div class="relative border-l border-line-300 pl-7">
            <span class="absolute -left-[7px] top-1 h-3.5 w-3.5 rounded-full border-4 border-white bg-blue-accent shadow-[0_0_0_2px_rgba(15,91,255,0.26)]"></span>
            <p class="text-xs font-extrabold text-blue-accent">{item.period}</p>
            {
              item.startDate && (
                <p
                  class="mt-1 text-xs font-bold text-ink-400"
                  data-career-duration
                  data-locale={locale}
                  data-start={item.startDate}
                  data-end={item.endDate ?? ""}
                >
                  {formatDuration(item.startDate, item.endDate, locale)}
                </p>
              )
            }
            <h3 class="mt-3 text-xl font-extrabold tracking-tight text-ink-950">{item.company}</h3>
            <p class="mt-2 inline-flex rounded-full bg-blue-soft px-3 py-1 text-xs font-extrabold text-blue-accent">
              {item.role}
            </p>
          </div>
          <ul class="grid gap-2.5 text-sm font-medium leading-7 text-ink-700">
            {
              item.bullets.map((bullet) => (
                <li class="flex gap-3">
                  <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-accent"></span>
                  <span>{bullet}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    ))
  }
</div>

<script>
  type CareerLocale = "ko" | "en";

  function parseCareerDate(value: string) {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(year, month - 1, day);
  }

  function getCareerMonthDiff(startDate: string, endDate?: string) {
    const start = parseCareerDate(startDate);
    const end = endDate ? parseCareerDate(endDate) : new Date();
    let months = (end.getFullYear() - start.getFullYear()) * 12 + end.getMonth() - start.getMonth();

    if (end.getDate() < start.getDate()) {
      months -= 1;
    }

    return Math.max(months + 1, 0);
  }

  function formatCareerDuration(totalMonths: number, locale: CareerLocale) {
    const years = Math.floor(totalMonths / 12);
    const months = totalMonths % 12;

    if (locale === "ko") {
      if (years === 0 && months === 0) return "1개월 미만";
      if (years === 0) return `${months}개월`;
      if (months === 0) return `${years}년`;
      return `${years}년 ${months}개월`;
    }

    if (years === 0 && months === 0) return "less than 1 mo";
    if (years === 0) return `${months} mo${months > 1 ? "s" : ""}`;
    if (months === 0) return `${years} yr${years > 1 ? "s" : ""}`;
    return `${years} yr${years > 1 ? "s" : ""} ${months} mo${months > 1 ? "s" : ""}`;
  }

  document.querySelectorAll<HTMLElement>("[data-career-duration]").forEach((element) => {
    const startDate = element.dataset.start;
    if (!startDate) return;

    const endDate = element.dataset.end || undefined;
    const locale: CareerLocale = element.dataset.locale === "en" ? "en" : "ko";
    element.textContent = formatCareerDuration(getCareerMonthDiff(startDate, endDate), locale);
  });
</script>
