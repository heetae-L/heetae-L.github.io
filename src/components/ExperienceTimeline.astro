---
interface Props {
  items: readonly {
    period: string;
    company: string;
    role: string;
    bullets: readonly string[];
  }[];
}

const { items } = Astro.props;
---

<div class="grid gap-4">
  {
    items.map((item) => (
      <article class="soft-card rounded-3xl p-6 sm:p-7">
        <div class="grid gap-6 md:grid-cols-[260px_1fr]">
          <div class="relative border-l border-line-300 pl-7">
            <span class="absolute -left-[7px] top-1 h-3.5 w-3.5 rounded-full border-4 border-white bg-blue-accent shadow-[0_0_0_2px_rgba(15,91,255,0.26)]"></span>
            <p class="text-xs font-extrabold text-blue-accent">{item.period}</p>
            <h3 class="mt-3 text-xl font-extrabold tracking-tight text-ink-950">{item.company}</h3>
            <p class="mt-2 inline-flex rounded-full bg-blue-soft px-3 py-1 text-xs font-extrabold text-blue-accent">
              {item.role}
            </p>
          </div>
          <ul class="grid gap-2.5 text-sm font-medium leading-7 text-ink-700">
            {
              item.bullets.map((bullet) => (
                <li class="flex gap-3">
                  <span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-accent"></span>
                  <span>{bullet}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    ))
  }
</div>
