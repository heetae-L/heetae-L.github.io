---
import { GitBranch, Menu, Moon, Sun, X } from "@lucide/astro";
import DocumentActions from "./DocumentActions.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { type Locale, withLocale } from "../i18n/config";
import type { SiteContent } from "../data";

interface Props {
  locale: Locale;
  content: SiteContent;
  currentPath: string;
  portfolioMode?: boolean;
}

const { locale, content, currentPath, portfolioMode = false } = Astro.props;
const homeHref = portfolioMode ? withLocale(locale, "/portfolio") : withLocale(locale);
const normalizedPath = currentPath.replace(/\/$/, "") || `/${locale}`;

const navItems = [
  { label: content.nav.home, href: homeHref, isHome: true },
  { label: content.nav.projects, href: withLocale(locale, "/projects") },
  { label: content.nav.experience, href: withLocale(locale, "/experience") },
  { label: content.nav.techStack, href: withLocale(locale, "/tech-stack") }
].map((item) => {
  const itemPath = item.href.replace(/\/$/, "");
  return { ...item, active: normalizedPath === itemPath || (!item.isHome && normalizedPath.startsWith(`${itemPath}/`)) };
});

const switchToDarkLabel = locale === "ko" ? "다크 모드로 전환" : "Switch to dark mode";
const switchToLightLabel = locale === "ko" ? "라이트 모드로 전환" : "Switch to light mode";
const menuOpenLabel = locale === "ko" ? "메뉴 열기" : "Open menu";
const menuCloseLabel = locale === "ko" ? "메뉴 닫기" : "Close menu";
---

<header class="no-print sticky top-0 z-40 border-b border-line-200/80 bg-white/86 backdrop-blur-xl dark:bg-surface/95">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-2 px-3 sm:px-6 min-[700px]:h-16 min-[700px]:gap-0 lg:px-8">
    <a href={homeHref} data-portfolio-home={locale} class="hidden shrink-0 whitespace-nowrap text-lg font-extrabold tracking-tight text-ink-950 sm:text-xl min-[700px]:block">
      <span class="text-blue-accent">Heetae</span> Lee
    </a>

    <nav class="flex min-w-0 flex-1 items-center justify-start gap-1 text-xs font-bold text-ink-600 min-[700px]:flex-none min-[700px]:shrink-0 min-[700px]:gap-4 min-[700px]:text-[13px] min-[1100px]:gap-7" aria-label="Primary navigation">
      {
        navItems.map((item) => {
          return (
            <a
              href={item.href}
              data-portfolio-home={item.isHome ? locale : undefined}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "relative flex h-14 min-w-max flex-1 items-center justify-center whitespace-nowrap transition hover:text-blue-accent min-[700px]:h-auto min-[700px]:min-w-0 min-[700px]:flex-none min-[700px]:shrink-0 min-[700px]:py-6",
                item.active && "text-blue-accent after:absolute after:bottom-0 after:left-1/2 after:h-0.5 after:w-7 after:-translate-x-1/2 after:rounded-full after:bg-blue-accent"
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-3">
      <div class="hidden shrink-0 items-center gap-3 min-[700px]:flex">
        <DocumentActions locale={locale} portfolioMode={portfolioMode} />
        <div class="hidden min-[940px]:block">
          <LanguageSwitcher locale={locale} currentPath={currentPath} />
        </div>
        <button
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-line-200 bg-white text-ink-800 shadow-sm transition hover:border-blue-accent/40 hover:text-blue-accent sm:h-10 sm:w-10 dark:bg-surface-raised"
          aria-label={switchToDarkLabel}
          title={switchToDarkLabel}
          data-theme-toggle
          data-light-label={switchToDarkLabel}
          data-dark-label={switchToLightLabel}
        >
          <Moon class="h-5 w-5 dark:hidden" aria-hidden="true" />
          <Sun class="hidden h-5 w-5 dark:block" aria-hidden="true" />
        </button>
        {
          !portfolioMode && (
            <a
              href="https://github.com/heetae-L"
              data-hide-in-portfolio
              target="_blank"
              rel="noreferrer"
              class="inline-flex h-9 w-9 items-center justify-center rounded-xl border border-line-200 bg-white text-ink-800 shadow-sm transition hover:border-blue-accent/30 hover:text-blue-accent sm:h-10 sm:w-10 dark:bg-surface-raised"
              aria-label="GitHub"
              title="GitHub"
            >
              <GitBranch class="h-5 w-5" />
            </a>
          )
        }
      </div>

      <button
        type="button"
        class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-line-200 bg-white text-ink-900 min-[700px]:h-10 min-[700px]:w-10 min-[940px]:hidden dark:bg-surface-raised"
        aria-label={menuOpenLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-open-label={menuOpenLabel}
        data-close-label={menuCloseLabel}
      >
        <Menu class="h-5 w-5" data-menu-icon="open" />
        <X class="hidden h-5 w-5" data-menu-icon="close" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="absolute inset-x-0 top-full hidden max-h-[calc(100dvh-3.5rem-1px)] overflow-y-auto border-t border-line-200 bg-white px-4 py-4 shadow-lg sm:px-6 min-[700px]:max-h-[calc(100dvh-4rem-1px)] min-[940px]:hidden dark:bg-surface" data-mobile-menu>
    <div class="min-[700px]:hidden">
      <DocumentActions locale={locale} portfolioMode={portfolioMode} variant="menu" />
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line-200 pt-4 min-[700px]:mt-0 min-[700px]:justify-end min-[700px]:border-0 min-[700px]:pt-0">
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
      <div class="flex items-center gap-2 min-[700px]:hidden">
        <button
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line-200 bg-white text-ink-800 shadow-sm transition hover:border-blue-accent/40 hover:text-blue-accent dark:bg-surface-raised"
          aria-label={switchToDarkLabel}
          title={switchToDarkLabel}
          data-theme-toggle
          data-light-label={switchToDarkLabel}
          data-dark-label={switchToLightLabel}
        >
          <Moon class="h-5 w-5 dark:hidden" aria-hidden="true" />
          <Sun class="hidden h-5 w-5 dark:block" aria-hidden="true" />
        </button>
        {!portfolioMode && (
          <a href="https://github.com/heetae-L" data-hide-in-portfolio target="_blank" rel="noreferrer" class="inline-flex h-10 items-center gap-2 rounded-xl border border-line-200 bg-white px-3 text-xs font-bold text-ink-800 shadow-sm transition hover:border-blue-accent/30 hover:text-blue-accent dark:bg-surface-raised">
            <GitBranch class="h-4 w-4" aria-hidden="true" />
            GitHub
          </a>
        )}
      </div>
    </div>
  </div>
</header>

<script>
  if (document.documentElement.classList.contains("portfolio-mode")) {
    document.querySelectorAll<HTMLAnchorElement>("[data-portfolio-home]").forEach((link) => {
      const locale = link.dataset.portfolioHome;

      if (locale) {
        link.href = `/${locale}/portfolio`;
      }
    });
  }

  const menuButton = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");
  const openIcon = document.querySelector('[data-menu-icon="open"]');
  const closeIcon = document.querySelector('[data-menu-icon="close"]');

  function closeMobileMenu() {
    menuButton?.setAttribute("aria-expanded", "false");
    mobileMenu?.classList.add("hidden");
    openIcon?.classList.remove("hidden");
    closeIcon?.classList.add("hidden");
    menuButton?.setAttribute("aria-label", (menuButton as HTMLElement).dataset.openLabel ?? "Open menu");
  }

  document.addEventListener("document-menu-open", closeMobileMenu);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuButton?.getAttribute("aria-expanded") === "true") {
      closeMobileMenu();
      (menuButton as HTMLButtonElement).focus();
    }
  });
  window.addEventListener("resize", closeMobileMenu);
  document.addEventListener("pointerdown", (event) => {
    if (event.target instanceof Node && !menuButton?.contains(event.target) && !mobileMenu?.contains(event.target)) closeMobileMenu();
  });
  mobileMenu?.querySelectorAll("a").forEach((link) => { link.addEventListener("click", closeMobileMenu); });

  const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  let manualTheme: "light" | "dark" | null = null;

  function syncThemeButtons() {
    const isDark = document.documentElement.classList.contains("dark");
    themeButtons.forEach((button) => {
      const label = isDark ? button.dataset.darkLabel : button.dataset.lightLabel;
      if (label) {
        button.setAttribute("aria-label", label);
        button.title = label;
      }
    });
  }

  syncThemeButtons();
  themeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      manualTheme = isDark ? "dark" : "light";
      try {
        localStorage.setItem("heetae-theme", isDark ? "dark" : "light");
      } catch {
        // Theme switching still works for the current page.
      }
      syncThemeButtons();
    });
  });

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
    let savedTheme: string | null = null;
    try {
      savedTheme = localStorage.getItem("heetae-theme");
    } catch {
      // An unavailable storage API leaves the theme in automatic mode.
    }
    if (manualTheme || savedTheme === "light" || savedTheme === "dark") return;
    document.documentElement.classList.toggle("dark", event.matches);
    syncThemeButtons();
  });

  menuButton?.addEventListener("click", () => {
    document.querySelectorAll<HTMLDetailsElement>("[data-document-menu]").forEach((menu) => { menu.open = false; });
    const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isExpanded));
    menuButton.setAttribute("aria-label", (menuButton as HTMLElement).dataset[isExpanded ? "openLabel" : "closeLabel"] ?? "Open menu");
    mobileMenu?.classList.toggle("hidden", isExpanded);
    openIcon?.classList.toggle("hidden", !isExpanded);
    closeIcon?.classList.toggle("hidden", isExpanded);
  });
</script>
