---
import { Download, GitBranch, Menu, Moon, Sun, X } from "@lucide/astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { portfolioDownloadPath, type Locale, withLocale } from "../i18n/config";
import type { SiteContent } from "../data";

interface Props {
  locale: Locale;
  content: SiteContent;
  currentPath: string;
  portfolioMode?: boolean;
}

const { locale, content, currentPath, portfolioMode = false } = Astro.props;
const homeHref = portfolioMode ? withLocale(locale, "/portfolio") : withLocale(locale);
const downloadPath = portfolioDownloadPath(portfolioMode);
const downloadFileName = downloadPath.split("/").at(-1);

const navItems = [
  { label: content.nav.home, href: homeHref, isHome: true },
  { label: content.nav.projects, href: withLocale(locale, "/projects") },
  { label: content.nav.experience, href: withLocale(locale, "/experience") },
  { label: content.nav.techStack, href: withLocale(locale, "/tech-stack") }
];

const normalizedPath = currentPath.replace(/\/$/, "") || `/${locale}`;
const switchToDarkLabel = locale === "ko" ? "다크 모드로 전환" : "Switch to dark mode";
const switchToLightLabel = locale === "ko" ? "라이트 모드로 전환" : "Switch to light mode";
const darkModeLabel = locale === "ko" ? "다크 모드" : "Dark mode";
const lightModeLabel = locale === "ko" ? "라이트 모드" : "Light mode";
---

<header class="no-print sticky top-0 z-40 border-b border-line-200/80 bg-white/86 backdrop-blur-xl dark:bg-surface/95">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-6 lg:px-8">
    <a href={homeHref} data-portfolio-home={locale} class="shrink-0 whitespace-nowrap text-xl font-extrabold tracking-tight text-ink-950">
      <span class="text-blue-accent">Heetae</span> Lee
    </a>

    <nav class="hidden shrink-0 items-center gap-7 text-[13px] font-bold text-ink-600 min-[640px]:flex" aria-label="Primary navigation">
      {
        navItems.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || `/${locale}`;
          const isHome = itemPath === `/${locale}`;
          const active = isHome ? normalizedPath === itemPath : normalizedPath === itemPath || normalizedPath.startsWith(`${itemPath}/`);

          return (
            <a
              href={item.href}
              data-portfolio-home={item.isHome ? locale : undefined}
              aria-current={active ? "page" : undefined}
              class:list={[
                "relative py-6 transition hover:text-blue-accent",
                active && "text-blue-accent after:absolute after:bottom-0 after:left-1/2 after:h-0.5 after:w-7 after:-translate-x-1/2 after:rounded-full after:bg-blue-accent"
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden shrink-0 items-center gap-3 min-[640px]:flex">
      <div class="hidden items-center gap-3 min-[900px]:flex">
        <a
          href={downloadPath}
          download={downloadFileName}
          data-portfolio-download
          class="inline-flex h-10 items-center gap-2 rounded-xl bg-blue-action px-4 text-sm font-extrabold text-white shadow-[0_10px_24px_rgba(15,91,255,0.22)] transition hover:bg-blue-700"
        >
          <Download class="h-4 w-4" />
          {content.common.downloadPortfolio}
        </a>
        <LanguageSwitcher locale={locale} currentPath={currentPath} />
      </div>
      <button
        type="button"
        class="hidden h-10 w-10 items-center justify-center rounded-xl border border-line-200 bg-white text-ink-800 shadow-sm transition hover:border-blue-accent/40 hover:text-blue-accent min-[900px]:inline-flex dark:bg-surface-raised"
        aria-label={switchToDarkLabel}
        title={switchToDarkLabel}
        data-theme-toggle
        data-light-label={switchToDarkLabel}
        data-dark-label={switchToLightLabel}
      >
        <Moon class="h-5 w-5 dark:hidden" aria-hidden="true" />
        <Sun class="hidden h-5 w-5 dark:block" aria-hidden="true" />
      </button>
      {
        !portfolioMode && (
          <a
            href="https://github.com/heetae-L"
            data-hide-in-portfolio
            target="_blank"
            rel="noreferrer"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line-200 bg-white text-ink-800 shadow-sm transition hover:border-blue-accent/30 hover:text-blue-accent dark:bg-surface-raised"
            aria-label="GitHub"
          >
            <GitBranch class="h-5 w-5" />
          </a>
        )
      }
    </div>

    <button
      type="button"
      class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-line-200 bg-white text-ink-900 min-[900px]:hidden dark:bg-surface-raised"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <Menu class="h-5 w-5" data-menu-icon="open" />
      <X class="hidden h-5 w-5" data-menu-icon="close" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line-200 bg-white px-5 py-5 min-[900px]:hidden dark:bg-surface" data-mobile-menu>
    <nav class="grid gap-2 text-sm font-bold text-ink-700 min-[640px]:hidden" aria-label="Mobile navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-portfolio-home={item.isHome ? locale : undefined}
            class="rounded-xl px-3 py-3 hover:bg-blue-soft hover:text-blue-accent"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-5 flex flex-wrap items-center gap-3 min-[640px]:mt-0 min-[640px]:justify-end">
      <a
        href={downloadPath}
        download={downloadFileName}
        data-portfolio-download
        class="inline-flex h-10 items-center gap-2 rounded-xl bg-blue-action px-4 text-sm font-extrabold text-white"
      >
        <Download class="h-4 w-4" />
        {content.common.downloadPortfolio}
      </a>
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
      <button
        type="button"
        class="inline-flex h-10 items-center gap-2 rounded-xl border border-line-200 bg-white px-3 text-ink-800 transition hover:border-blue-accent/40 hover:text-blue-accent dark:bg-surface-raised"
        aria-label={switchToDarkLabel}
        title={switchToDarkLabel}
        data-theme-toggle
        data-light-label={switchToDarkLabel}
        data-dark-label={switchToLightLabel}
        data-light-text={darkModeLabel}
        data-dark-text={lightModeLabel}
      >
        <Moon class="h-4 w-4 dark:hidden" aria-hidden="true" />
        <Sun class="hidden h-4 w-4 dark:block" aria-hidden="true" />
        <span data-theme-label>{darkModeLabel}</span>
      </button>
      {
        !portfolioMode && (
          <a
            href="https://github.com/heetae-L"
            data-hide-in-portfolio
            target="_blank"
            rel="noreferrer"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line-200 bg-white text-ink-800 shadow-sm transition hover:border-blue-accent/30 hover:text-blue-accent min-[640px]:hidden dark:bg-surface-raised"
            aria-label="GitHub"
          >
            <GitBranch class="h-5 w-5" />
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  import { portfolioDownloadPath } from "../i18n/config";

  if (document.documentElement.classList.contains("portfolio-mode")) {
    document.querySelectorAll<HTMLAnchorElement>("[data-portfolio-home]").forEach((link) => {
      const locale = link.dataset.portfolioHome;

      if (locale) {
        link.href = `/${locale}/portfolio`;
      }
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-portfolio-download]").forEach((link) => {
      const path = portfolioDownloadPath(true);
      link.href = path;
      link.download = path.split("/").at(-1) ?? "heetae-lee-portfolio-submission.pdf";
    });
  }

  const menuButton = document.querySelector("[data-menu-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");
  const openIcon = document.querySelector('[data-menu-icon="open"]');
  const closeIcon = document.querySelector('[data-menu-icon="close"]');

  const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  function syncThemeButtons() {
    const isDark = document.documentElement.classList.contains("dark");
    themeButtons.forEach((button) => {
      const label = isDark ? button.dataset.darkLabel : button.dataset.lightLabel;
      if (label) {
        button.setAttribute("aria-label", label);
        button.title = label;
      }
      const text = button.querySelector("[data-theme-label]");
      if (text) text.textContent = isDark ? button.dataset.darkText ?? "" : button.dataset.lightText ?? "";
    });
  }

  syncThemeButtons();
  themeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("heetae-theme", isDark ? "dark" : "light");
      } catch {
        // Theme switching still works for the current page.
      }
      syncThemeButtons();
    });
  });

  menuButton?.addEventListener("click", () => {
    const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isExpanded));
    mobileMenu?.classList.toggle("hidden", isExpanded);
    openIcon?.classList.toggle("hidden", !isExpanded);
    closeIcon?.classList.toggle("hidden", isExpanded);
  });
</script>
