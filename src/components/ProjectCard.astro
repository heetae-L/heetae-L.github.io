---
import { ArrowRight } from "@lucide/astro";
import IconBadge from "./IconBadge.astro";
import type { Project } from "../data";

interface Props {
  project: Project;
  href: string;
  variant?: "compact" | "wide";
  label?: string;
}

const { project, href, variant = "compact", label = "Details" } = Astro.props;

const tone = {
  cart: "green",
  bot: "purple",
  chart: "orange",
  infinity: "blue"
}[project.icon] ?? "blue";
---

<a
  href={href}
  class:list={[
    "group soft-card-flat rounded-2xl transition hover:-translate-y-0.5 hover:border-blue-accent/30 hover:shadow-[0_22px_54px_rgba(15,91,255,0.08)]",
    variant === "wide" ? "flex items-center gap-5 p-5" : "flex h-full flex-col p-5"
  ]}
>
  <IconBadge name={project.icon} tone={tone as "blue" | "green" | "purple" | "orange"} size="lg" />
  <div class:list={[variant === "wide" ? "min-w-0 flex-1" : "mt-5 flex flex-1 flex-col"]}>
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-base font-extrabold leading-snug text-ink-950 sm:text-lg">{project.title}</h3>
      {variant === "wide" && <ArrowRight class="mt-1 h-5 w-5 shrink-0 text-blue-accent transition group-hover:translate-x-1" />}
    </div>
    <p class="mt-3 text-sm font-medium leading-6 text-ink-500">{project.summary}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {project.tags.map((tag) => <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-ink-600">{tag}</span>)}
    </div>
    {
      variant === "compact" && (
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-extrabold text-blue-accent">
          {label}
          <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" />
        </span>
      )
    }
  </div>
</a>
