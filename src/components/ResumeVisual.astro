---
import { GitBranch, PanelRight, SquareCode } from "@lucide/astro";

interface Props {
  title: string;
  lines: readonly string[];
}

const { title, lines } = Astro.props;
const lineNumbers = Array.from({ length: lines.length + 4 }, (_, index) => index + 1);
---

<div class="resume-visual relative isolate mx-auto h-[370px] w-full max-w-[360px] sm:h-[410px] lg:h-auto lg:min-h-[420px] lg:max-w-[400px]" aria-label={title}>
  <div class="code-window absolute right-3 top-2 w-[calc(100%-24px)] max-w-[320px] lg:right-0 lg:top-6 lg:w-[320px]" lang="en">
    <div class="code-header">
      <SquareCode size={14} class="file-icon" aria-hidden="true" />
      <span>BackendService.java</span>
      <PanelRight size={13} class="panel-icon" aria-hidden="true" />
    </div>
    <div class="code-editor">
      <div class="line-numbers" aria-hidden="true">{lineNumbers.map((number) => <span>{number}</span>)}</div>
      <pre><code><span class="keyword">public class</span> <span class="type">BackendService</span> {"{"}
  <span class="keyword">void</span> <span class="method">build</span>() {"{"}
{lines.map((line) => <Fragment>{"    "}<span class="method">{line.replace(/\(\);$/, "")}</span>{"();\n"}</Fragment>)}  {"}"}
{"}"}</code></pre>
    </div>
    <div class="code-footer">
      <span class="profile" aria-label="HT profile">HT</span>
      <span class="branch"><GitBranch size={11} aria-hidden="true" />main</span>
      <span class="language">Java</span>
    </div>
  </div>
</div>

<style>
  .resume-visual {
    container-type: inline-size;
    --code-bg: #fff;
    --code-chrome: #f8f9fb;
    --code-ink: #43516a;
    --code-muted: #778295;
    --code-line: #e7ebf2;
    --code-blue: #245cd7;
    --code-purple: #7860a5;
    --code-type: #283b58;
    --code-profile-bg: #e2e8f1;
    --code-profile-ink: #44546c;
    --code-shadow: 0 22px 48px #1e38631c, 0 2px 5px #1e386308;
  }

  :global(html.dark) .resume-visual {
    --code-bg: #212329;
    --code-chrome: #282b32;
    --code-ink: #bdc7d8;
    --code-muted: #929daf;
    --code-line: #3a404a;
    --code-blue: #9ab9ff;
    --code-purple: #b8a6d4;
    --code-type: #e0e8f5;
    --code-profile-bg: #414a59;
    --code-profile-ink: #edf1f8;
    --code-shadow: 0 22px 48px #0006, 0 2px 5px #0003;
  }

  .code-window {
    overflow: hidden;
    border: 1px solid var(--code-line);
    border-radius: 16px;
    background: var(--code-bg);
    color: var(--code-ink);
    box-shadow: var(--code-shadow);
    transform: rotate(1.5deg);
    -webkit-font-smoothing: antialiased;
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 9px;
    height: 40px;
    padding: 0 16px;
    border-bottom: 1px solid var(--code-line);
    background: var(--code-chrome);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .1px;
  }

  .file-icon { color: var(--code-blue); flex: none; }
  .panel-icon { margin-left: auto; color: var(--code-muted); flex: none; }
  .code-editor { display: flex; gap: 13px; padding: 20px 16px 22px 13px; }

  .line-numbers {
    display: flex;
    flex-direction: column;
    flex: none;
    width: 15px;
    color: var(--code-muted);
    opacity: .65;
    text-align: right;
    font: 11px/24px Consolas, "SFMono-Regular", "Liberation Mono", monospace;
    user-select: none;
  }

  pre {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--code-ink);
    white-space: pre;
    overflow-wrap: normal;
    font: 11.5px/24px Consolas, "SFMono-Regular", "Liberation Mono", monospace;
    letter-spacing: -.15px;
  }

  code { font: inherit; }
  .keyword { color: var(--code-purple); }
  .type { color: var(--code-type); }
  .method { color: var(--code-blue); }

  .code-footer {
    display: flex;
    align-items: center;
    gap: 11px;
    height: 36px;
    padding: 0 13px;
    border-top: 1px solid var(--code-line);
    background: var(--code-chrome);
    color: var(--code-muted);
    font-size: 10px;
  }

  .profile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 23px;
    height: 23px;
    border-radius: 50%;
    background: var(--code-profile-bg);
    color: var(--code-profile-ink);
    font-size: 8px;
    font-weight: 650;
    letter-spacing: .15px;
  }

  .branch { display: flex; align-items: center; gap: 4px; }
  .language { margin-left: auto; }

  @container (max-width: 290px) {
    .code-window { transform: none; }
    .line-numbers { display: none; }
    .code-editor { padding-right: 12px; padding-left: 12px; }
    pre { font-size: clamp(9px, 4cqw, 11.5px); }
    .code-header { padding: 0 12px; gap: 7px; }
  }

  @media print {
    .resume-visual, :global(html.dark) .resume-visual {
      --code-bg: #fff;
      --code-chrome: #f8f9fb;
      --code-ink: #43516a;
      --code-muted: #778295;
      --code-line: #e7ebf2;
      --code-blue: #245cd7;
      --code-purple: #7860a5;
      --code-type: #283b58;
      --code-profile-bg: #e2e8f1;
      --code-profile-ink: #44546c;
      --code-shadow: none;
    }
    .code-window { transform: none; }
  }
</style>
