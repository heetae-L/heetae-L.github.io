---
import { Activity, Braces, Database, Upload } from "@lucide/astro";

interface Props {
  title: string;
  lines: readonly string[];
}

const { title, lines } = Astro.props;

const nodes = [
  { label: "API", icon: Braces, className: "bottom-6 left-0 lg:bottom-20 lg:left-3" },
  { label: "Deploy", icon: Upload, className: "bottom-0 left-[25%] lg:bottom-8 lg:left-24" },
  { label: "Monitor", icon: Activity, className: "bottom-2 right-[24%] lg:bottom-4 lg:right-12" },
  { label: "DB", icon: Database, className: "bottom-7 right-0 lg:bottom-20" }
];
---

<div class="relative isolate mx-auto h-[370px] w-full max-w-[360px] sm:h-[410px] lg:h-auto lg:min-h-[420px] lg:max-w-[400px]" aria-label={title}>
  <div class="absolute inset-x-10 bottom-8 hidden h-28 rounded-[50%] bg-blue-accent/12 blur-2xl lg:block"></div>
  <div class="absolute left-12 top-36 hidden h-64 w-64 rounded-full border border-blue-accent/10 lg:block"></div>
  <div class="absolute left-4 top-48 hidden h-48 w-48 rounded-full border border-blue-accent/10 lg:block"></div>

  <div class="absolute right-3 top-2 z-20 w-[calc(100%-24px)] max-w-[320px] rotate-2 rounded-[24px] border border-slate-700/30 bg-[#07142b] p-3 shadow-[0_24px_48px_rgba(8,21,48,0.18)] sm:p-5 lg:right-0 lg:top-6 lg:w-[320px] lg:rounded-[28px] lg:shadow-[0_34px_90px_rgba(8,21,48,0.28)] dark:border-line-300 dark:shadow-[0_34px_90px_rgba(0,0,0,0.45)]">
    <div class="mb-5 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="h-3 w-3 rounded-full bg-red-400"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-300"></span>
        <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
      </div>
      <div class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-2.5 text-[11px] font-black text-blue-200">
        <span class="font-mono text-sm">&lt;/&gt;</span>
        Code
      </div>
    </div>
    <pre class="overflow-hidden font-mono text-[10px] font-semibold leading-5 text-slate-200 sm:text-[12px] sm:leading-6"><code><span class="text-violet-300">public class</span> <span class="text-cyan-300">BackendService</span> {"{"}
  <span class="text-violet-300">void</span> <span class="text-cyan-300">build</span>() {"{"}
{lines.map((line) => `    ${line}\n`).join("")}  {"}"}
{"}"}</code></pre>
  </div>

  <div class="absolute bottom-7 left-2 right-2 z-10 h-16 rounded-[24px] border border-line-200 bg-white/70 shadow-[0_28px_70px_rgba(48,80,145,0.14)] backdrop-blur-sm lg:bottom-9 lg:left-4 lg:right-4 lg:h-28 lg:rounded-[34px] dark:bg-surface-raised/90"></div>
  <div class="absolute bottom-3 left-5 right-1 z-0 h-12 rounded-[24px] bg-blue-accent/70 shadow-[0_20px_36px_rgba(15,91,255,0.18)] lg:bottom-1 lg:left-9 lg:right-0 lg:h-16 lg:rounded-[34px] lg:shadow-[0_28px_54px_rgba(15,91,255,0.24)] dark:bg-blue-action/80"></div>

  {
    nodes.map((node) => (
      <div class:list={["absolute z-30 grid h-[60px] w-[52px] place-items-center rounded-2xl border border-line-200 bg-white text-center shadow-lg lg:h-20 lg:w-20 lg:rounded-3xl lg:shadow-xl dark:bg-surface-raised dark:shadow-[0_14px_32px_rgba(0,0,0,0.3)]", node.className]}>
        <div>
          <node.icon class="mx-auto h-4 w-4 text-blue-accent lg:hidden" aria-hidden="true" />
          <span class="mx-auto hidden h-6 w-6 rounded-xl bg-blue-accent/12 ring-1 ring-blue-accent/15 lg:block"></span>
          <span class="mt-2 block text-[10px] font-black text-ink-900 lg:text-xs">{node.label}</span>
        </div>
      </div>
    ))
  }
  <div class="absolute bottom-12 left-[58%] z-20 hidden h-20 w-20 -translate-x-1/2 rounded-3xl border border-line-200 bg-white shadow-xl lg:block dark:bg-surface-raised">
    <div class="absolute inset-5 rounded-2xl bg-blue-accent shadow-inner dark:bg-blue-action"></div>
  </div>
</div>
