---
interface Props {
  title: string;
  lines: readonly string[];
}

const { title, lines } = Astro.props;

const nodes = [
  { label: "API", className: "bottom-20 left-3" },
  { label: "Deploy", className: "bottom-8 left-24" },
  { label: "Monitor", className: "bottom-4 right-12" },
  { label: "DB", className: "bottom-20 right-0" }
];
---

<div class="relative isolate mx-auto hidden min-h-[420px] w-full max-w-[400px] lg:block" aria-label={title}>
  <div class="absolute inset-x-10 bottom-8 h-28 rounded-[50%] bg-blue-accent/12 blur-2xl"></div>
  <div class="absolute left-12 top-36 h-64 w-64 rounded-full border border-blue-accent/10"></div>
  <div class="absolute left-4 top-48 h-48 w-48 rounded-full border border-blue-accent/10"></div>

  <div class="absolute right-0 top-6 z-20 w-[320px] rotate-2 rounded-[28px] border border-slate-700/30 bg-[#07142b] p-5 shadow-[0_34px_90px_rgba(8,21,48,0.28)]">
    <div class="mb-5 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="h-3 w-3 rounded-full bg-red-400"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-300"></span>
        <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
      </div>
      <div class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-2.5 text-[11px] font-black text-blue-200">
        <span class="font-mono text-sm">&lt;/&gt;</span>
        Code
      </div>
    </div>
    <pre class="overflow-hidden font-mono text-[12px] font-semibold leading-6 text-slate-200"><code><span class="text-violet-300">public class</span> <span class="text-cyan-300">BackendService</span> {"{"}
  <span class="text-violet-300">void</span> <span class="text-cyan-300">build</span>() {"{"}
{lines.map((line) => `    ${line}\n`).join("")}  {"}"}
{"}"}</code></pre>
  </div>

  <div class="absolute bottom-9 left-4 right-4 z-10 h-28 rounded-[34px] border border-line-200 bg-white/70 shadow-[0_28px_70px_rgba(48,80,145,0.14)] backdrop-blur-sm"></div>
  <div class="absolute bottom-1 left-9 right-0 z-0 h-16 rounded-[34px] bg-blue-accent/70 shadow-[0_28px_54px_rgba(15,91,255,0.24)]"></div>

  {
    nodes.map((node) => (
      <div class:list={["absolute z-30 grid h-20 w-20 place-items-center rounded-3xl border border-line-200 bg-white text-center shadow-xl", node.className]}>
        <div>
          <span class="mx-auto block h-6 w-6 rounded-xl bg-blue-accent/12 ring-1 ring-blue-accent/15"></span>
          <span class="mt-2 block text-xs font-black text-ink-900">{node.label}</span>
        </div>
      </div>
    ))
  }
  <div class="absolute bottom-12 left-[58%] z-20 h-20 w-20 -translate-x-1/2 rounded-3xl border border-line-200 bg-white shadow-xl">
    <div class="absolute inset-5 rounded-2xl bg-blue-accent shadow-inner"></div>
  </div>
</div>
