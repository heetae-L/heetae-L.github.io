---
import IconBadge from "./IconBadge.astro";

interface Props {
  groups: readonly {
    icon: string;
    title: string;
    items: readonly string[];
  }[];
}

const { groups } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    groups.map((group) => (
      <article class="soft-card-flat rounded-2xl p-5">
        <div class="mb-4 flex items-center gap-3">
          <IconBadge name={group.icon} />
          <h3 class="text-base font-extrabold text-ink-950">{group.title}</h3>
        </div>
        <ul class="grid gap-2 text-sm font-semibold text-ink-600">
          {group.items.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    ))
  }
</div>
