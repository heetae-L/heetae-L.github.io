---
import { ArrowRight } from "@lucide/astro";
import type { TechStackGroupData } from "../data/types";
import IconBadge from "./IconBadge.astro";

interface Props {
  groups: readonly TechStackGroupData[];
  variant?: "compact" | "detailed";
  baseHref?: string;
}

const { groups, variant = "compact", baseHref } = Astro.props;
const isDetailed = variant === "detailed";
const compactGridClass = groups.length >= 5 ? "grid gap-4 sm:grid-cols-2 lg:grid-cols-5" : "grid gap-4 sm:grid-cols-2 lg:grid-cols-4";
const gridClass = isDetailed ? "grid gap-4 lg:grid-cols-2" : compactGridClass;
const cardClass =
  "group soft-card-flat rounded-2xl p-5 transition hover:-translate-y-0.5 hover:border-blue-accent/30 hover:shadow-[0_22px_54px_rgba(15,91,255,0.08)]";
---

<div class={gridClass}>
  {
    groups.map((group) => {
      const content = (
        <>
          <div class="mb-4 flex items-center gap-3">
            <IconBadge name={group.icon} />
            <div>
              <h3 class="text-base font-extrabold text-ink-950">{group.title}</h3>
              {isDetailed && <p class="mt-1 text-sm font-medium leading-6 text-ink-500">{group.summary}</p>}
            </div>
          </div>
          <ul class:list={[isDetailed ? "grid gap-3" : "grid gap-2", "text-sm text-ink-600"]}>
            {
              group.items.map((item) => (
                <li>
                  <span class="font-extrabold text-ink-800">{item.name}</span>
                  {isDetailed && <span class="mt-1 block font-medium leading-6 text-ink-500">{item.description}</span>}
                </li>
              ))
            }
          </ul>
          {
            baseHref && (
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-extrabold text-blue-accent">
                View stack
                <ArrowRight class="h-4 w-4 transition group-hover:translate-x-1" />
              </span>
            )
          }
        </>
      );

      return baseHref ? (
        <a id={group.id} href={`${baseHref}#${group.id}`} class={cardClass}>
          {content}
        </a>
      ) : (
        <article id={group.id} class:list={[cardClass, "scroll-mt-28"]}>
          {content}
        </article>
      );
    })
  }
</div>
