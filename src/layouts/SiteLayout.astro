---
import Header from "../components/Header.astro";
import "../styles/global.css";
import type { SiteContent } from "../data";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  content: SiteContent;
  title?: string;
  description?: string;
  portfolioMode?: boolean;
  noIndex?: boolean;
}

const {
  locale,
  content,
  title = content.meta.title,
  description = content.meta.description,
  portfolioMode = false,
  noIndex = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://heetae-l.github.io").toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {import.meta.env.PROD && (
      <script is:inline>
        (() => {
          // Production builds can also be previewed locally without collecting visits.
          if (window.location.hostname !== "heetae-l.github.io") return;

          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", "G-B05RJDTZCM", {
            allow_google_signals: false,
            allow_ad_personalization_signals: false,
            page_location: window.location.origin + window.location.pathname
          });

          const tag = document.createElement("script");
          tag.async = true;
          tag.src = "https://www.googletagmanager.com/gtag/js?id=G-B05RJDTZCM";
          document.head.appendChild(tag);
        })();
      </script>
    )}
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css"
    />
    <title>{title}</title>
    <script is:inline>
      let savedTheme = null;
      try {
        savedTheme = localStorage.getItem("heetae-theme");
      } catch {
        // Fall back to the system preference when storage is unavailable.
      }
      const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", savedTheme === "dark" || (savedTheme !== "light" && systemPrefersDark));
    </script>
    <script is:inline define:vars={{ portfolioMode, locale }}>
      (() => {
        const storageKey = "heetae-portfolio-mode";
        const normalizedPath = window.location.pathname.replace(/\/+$/, "") || "/";
        const regularHomePath = `/${locale}`;

        try {
          if (portfolioMode) {
            window.sessionStorage.setItem(storageKey, "true");
          } else if (normalizedPath === regularHomePath) {
            window.sessionStorage.removeItem(storageKey);
          }

          if (portfolioMode || window.sessionStorage.getItem(storageKey) === "true") {
            document.documentElement.classList.add("portfolio-mode");
          }
        } catch {
          if (portfolioMode) {
            document.documentElement.classList.add("portfolio-mode");
          }
        }
      })();
    </script>
    <style is:global>
      html.portfolio-mode [data-hide-in-portfolio] {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <script>
      import { bindVisitorAlertPreference, installVisitorAlerts } from "../scripts/visitor-alerts.mjs";
      bindVisitorAlertPreference(window, document.querySelector<HTMLInputElement>("[data-visitor-alert-preference]"),
        document.querySelector<HTMLElement>("[data-visitor-alert-status]"));
      installVisitorAlerts(window, document, import.meta.env.PUBLIC_VISITOR_ALERT_URL, import.meta.env.PROD);
    </script>
    <Header locale={locale} content={content} currentPath={Astro.url.pathname} portfolioMode={portfolioMode} />
    <slot />
    <footer class="mx-auto max-w-6xl px-5 py-10 text-center text-xs font-semibold text-ink-400 sm:px-6 lg:px-8">
      {content.footer}
      <details class="no-print mx-auto mt-4 max-w-xl text-left text-xs font-normal leading-6">
        <summary class="mx-auto w-fit cursor-pointer rounded px-2 py-1 font-semibold text-ink-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-accent">
          {locale === "ko" ? "방문 정보 안내" : "Visitor information"}
        </summary>
        <div class="mt-3 border-t border-line-200 pt-3 text-ink-500">
          <p>{locale === "ko"
            ? "방문 현황 확인을 위해 페이지·접속 시각·추정 국가/도시·기기/브라우저 유형을 Cloudflare를 통해 운영자의 Telegram으로 전송합니다. 이름·연락처·주소의 query/hash·원본 IP는 Telegram 알림에 포함하지 않습니다."
            : "Page, time, approximate country/city and device/browser type are sent through Cloudflare to the owner's Telegram to monitor visits. Notifications do not include names, contact details, URL query/hash or raw IP addresses."}</p>
          <p class="mt-2">{locale === "ko"
            ? "중복·남용 방지용 해시 기록은 24시간 후 만료되고 주기적으로 삭제하며, Telegram 알림은 운영자가 삭제할 때까지 남습니다. Cloudflare는 요청 처리 과정에서 IP를 처리합니다. 아래 설정은 이 브라우저의 이후 방문 알림 전송에 적용되며, 별도로 사용 중인 Google Analytics에는 영향을 주지 않습니다. 브라우저의 DNT/GPC 설정도 존중합니다."
            : "Hashed records for deduplication and abuse prevention expire after 24 hours and are periodically removed. Telegram messages remain until the owner deletes them. Cloudflare processes IP addresses when handling requests. The setting below applies to future visitor alerts from this browser, not to the separate Google Analytics measurement. Browser DNT/GPC preferences are respected."}</p>
          <label class="mt-3 inline-flex min-h-11 cursor-pointer items-center gap-3 font-semibold text-ink-600">
            <input type="checkbox" checked data-visitor-alert-preference class="h-4 w-4 accent-blue-accent" />
            {locale === "ko" ? "방문 알림 정보 전송 허용" : "Allow visitor alert data"}
          </label>
          <p hidden data-visitor-alert-status class="mt-1 text-ink-500" role="status"
            data-dnt={locale === "ko" ? "브라우저의 추적 금지(DNT) 설정으로 전송하지 않습니다." : "Not sent because your browser requests Do Not Track (DNT)."}
            data-gpc={locale === "ko" ? "브라우저의 개인정보 보호(GPC) 설정으로 전송하지 않습니다." : "Not sent because your browser enables Global Privacy Control (GPC)."}
            data-owner={locale === "ko" ? "이 브라우저의 방문 알림 전송을 제외했습니다." : "Visitor alerts are excluded for this browser."}
            data-storage-read={locale === "ko" ? "브라우저 저장소를 읽을 수 없어 전송하지 않습니다." : "Not sent because browser storage is unavailable."}
            data-storage-write={locale === "ko" ? "설정을 저장할 수 없습니다. 브라우저 저장소 권한을 확인하세요." : "Could not save your preference. Check browser storage permissions."} />
        </div>
      </details>
    </footer>
  </body>
</html>
