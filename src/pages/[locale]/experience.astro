---
import ExperienceTimeline from "../../components/ExperienceTimeline.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getContent } from "../../data";
import { locales, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getContent(locale);
---

<SiteLayout locale={locale} content={t} title={`${t.experience.title} | Heetae Lee`} description={t.experience.description}>
  <main class="mx-auto max-w-6xl px-5 py-8 sm:px-6 sm:py-10 lg:px-8">
    <section class="resume-shell rounded-[28px] border border-line-200 bg-white/92 p-5 sm:p-8 lg:p-10">
      <SectionHeading eyebrow={t.experience.eyebrow} title={t.experience.title} description={t.experience.description} />
      <ExperienceTimeline items={t.experience.items} locale={locale} />
    </section>
  </main>
</SiteLayout>
