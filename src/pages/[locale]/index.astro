---
import { ArrowRight, Award, GraduationCap, Mail, Printer, ShieldCheck } from "@lucide/astro";
import ExperienceTimeline from "../../components/ExperienceTimeline.astro";
import IconBadge from "../../components/IconBadge.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ResumeVisual from "../../components/ResumeVisual.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SummaryCard from "../../components/SummaryCard.astro";
import TechStackGrid from "../../components/TechStackGrid.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getContent, getFeaturedProjects, getFeaturedTechStack, getResumeExperience } from "../../data";
import { locales, type Locale, withLocale } from "../../i18n/config";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getContent(locale);
const resumeExperience = getResumeExperience(locale);
const featuredProjects = getFeaturedProjects(locale, 4);
const featuredTechStack = getFeaturedTechStack(locale);
const militaryServiceParts = t.home.militaryService?.value.split(" · ");
const headlineLines = t.home.headline.split("\n");
const summaryLines = t.home.summary.split("\n");
---

<SiteLayout locale={locale} content={t}>
  <main class="mx-auto max-w-6xl px-5 py-8 sm:px-6 sm:py-10 lg:px-8">
    <div class="resume-shell rounded-[28px] border border-line-200 bg-white/92 p-5 sm:p-8 lg:p-10">
      <section class="grid min-h-[520px] min-w-0 items-center gap-8 lg:grid-cols-[minmax(0,1fr)_400px]">
        <div class="min-w-0">
          <span class="inline-flex items-center rounded-full bg-blue-soft px-4 py-2 text-xs font-extrabold text-blue-accent ring-1 ring-blue-accent/10">
            {t.home.badge}
          </span>
          <h1 class="mt-6 text-5xl font-black leading-[0.96] text-ink-950 sm:text-6xl lg:text-7xl">
            {t.home.name}
          </h1>
          <p class="mt-3 text-2xl font-black leading-tight text-blue-accent sm:text-3xl">{t.home.role}</p>
          <div class="mt-8 text-5xl font-black leading-[1.02] text-ink-950 sm:text-6xl lg:text-6xl">
            {headlineLines.map((line, index) => (
              <p>
                {index === headlineLines.length - 1 && line.includes("Last") ? (
                  <>
                    {line.replace("Last.", "")}
                    <span class="text-blue-accent">Last.</span>
                  </>
                ) : (
                  line
                )}
              </p>
            ))}
          </div>
          <p class="mt-5 grid max-w-2xl gap-1 text-base font-semibold leading-8 text-ink-700 [word-break:keep-all] sm:text-lg">
            {summaryLines.map((line) => <span>{line}</span>)}
          </p>
          <div class="mt-6 grid max-w-2xl grid-cols-2 gap-x-4 gap-y-5 lg:grid-cols-4">
            {
              t.home.heroSignals.map((item) => (
                <div class="min-w-0 border-line-200 lg:border-r lg:pr-4 last:border-r-0">
                  <IconBadge name={item.icon} size="sm" />
                  <p class="mt-3 text-sm font-black leading-5 text-ink-950">{item.title}</p>
                  <p class="mt-1 text-xs font-semibold leading-5 text-ink-500">{item.description}</p>
                </div>
              ))
            }
          </div>
          <div class="mt-7 flex flex-wrap gap-3">
            <button
              type="button"
              data-print-resume
              class="no-print inline-flex h-12 items-center gap-2 rounded-xl bg-blue-accent px-5 text-sm font-extrabold text-white shadow-[0_14px_30px_rgba(15,91,255,0.24)] transition hover:bg-blue-700"
            >
              <Printer class="h-4 w-4" />
              {t.common.downloadResume}
            </button>
            <a
              href={withLocale(locale, "/projects")}
              class="no-print inline-flex h-12 items-center gap-2 rounded-xl border border-line-200 bg-white px-5 text-sm font-extrabold text-ink-900 shadow-sm transition hover:border-blue-accent/30 hover:text-blue-accent"
            >
              {t.common.viewProjects}
              <ArrowRight class="h-4 w-4" />
            </a>
          </div>
        </div>
        <ResumeVisual title={t.home.visual.title} lines={t.home.visual.lines} />
      </section>

      <section class="mt-10">
        <SectionHeading title={t.home.careerSummaryTitle} />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {t.home.summaryCards.map((item) => <SummaryCard icon={item.icon} title={item.title} description={item.description} />)}
        </div>
      </section>

      <section class="mt-12">
        <SectionHeading title={t.home.workTitle} actionHref={withLocale(locale, "/experience")} actionLabel={t.common.viewFullExperience} />
        <ExperienceTimeline items={resumeExperience} locale={locale} linkHref={withLocale(locale, "/experience")} />
      </section>

      <section class="mt-12">
        <SectionHeading title={t.home.projectsTitle} actionHref={withLocale(locale, "/projects")} actionLabel={t.common.viewAllProjects} />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {featuredProjects.map((project) => <ProjectCard project={project} href={withLocale(locale, `/projects/${project.slug}`)} label={t.common.details} />)}
        </div>
      </section>

      <section class="mt-12">
        <SectionHeading title={t.home.techTitle} actionHref={withLocale(locale, "/tech-stack")} actionLabel={t.common.viewFullTechStack} />
        <TechStackGrid groups={featuredTechStack} baseHref={withLocale(locale, "/tech-stack")} />
      </section>

      <section class="mt-12 soft-card rounded-3xl p-6 sm:p-8">
        <SectionHeading title={t.home.educationTitle} />
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          <div class="flex gap-4">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-soft text-blue-accent">
              <GraduationCap class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-base font-extrabold text-ink-950">Education</h3>
              <p class="mt-3 text-sm font-bold text-ink-800">{t.home.education.school}</p>
              <p class="mt-1 text-sm font-semibold text-ink-500">{t.home.education.period}</p>
              {
                t.home.militaryService && (
                  <div class="mt-4 grid grid-cols-[16px_1fr] gap-3 border-t border-line-200 pt-4">
                    <ShieldCheck class="mt-0.5 h-4 w-4 text-blue-accent" />
                    <div>
                      <p class="text-[11px] font-extrabold leading-4 text-ink-500">{t.home.militaryService.label}</p>
                      <p class="mt-1 text-[13px] font-bold leading-5 text-ink-800">
                        <span class="block">{militaryServiceParts?.[0] ?? t.home.militaryService.value}</span>
                        {militaryServiceParts?.[1] && <span class="block">{militaryServiceParts[1]}</span>}
                      </p>
                    </div>
                  </div>
                )
              }
            </div>
          </div>
          <div class="flex gap-4 border-line-200 md:border-l md:pl-8">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-soft text-blue-accent">
              <Award class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-base font-extrabold text-ink-950">Certifications</h3>
              <ul class="mt-3 grid gap-2 text-sm font-semibold text-ink-600">
                {
                  t.home.certifications.map((item) => (
                    <li>
                      <span class="font-bold text-ink-800">{item.name}</span>
                      <span class="ml-2 text-ink-500">{item.issued}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div class="flex gap-4 border-line-200 lg:border-l lg:pl-8">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-soft text-blue-accent">
              <Mail class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-base font-extrabold text-ink-950">Contact</h3>
              <ul class="mt-3 grid gap-2 text-sm font-semibold text-ink-600">
                {
                  t.home.contact.map((item) => (
                    <li>
                      <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer" class="hover:text-blue-accent">
                        {item.value}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
</SiteLayout>
