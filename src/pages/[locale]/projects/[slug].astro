---
import { ArrowLeft } from "@lucide/astro";
import ArchitectureDiagram from "../../../components/ArchitectureDiagram.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getContent, getProject } from "../../../data";
import type { ProjectData } from "../../../data/types";
import { locales, type Locale, withLocale } from "../../../i18n/config";

export function getStaticPaths() {
  return locales.flatMap((locale) => {
    const t = getContent(locale);

    return t.projects.items.map((project) => ({
      params: { locale, slug: project.slug }
    }));
  });
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug as string;
const t = getContent(locale);
const project = getProject(locale, slug) ?? t.projects.items[0];
const projectData = project as ProjectData;
const detail = t.projectDetail;

type DetailSection = {
  id: string;
  title: string;
  body?: string;
  items?: string[];
};

const detailSections: DetailSection[] = [
  {
    id: "overview",
    title: detail.overview,
    body: projectData.overview ?? projectData.summary
  },
  {
    id: "problem",
    title: detail.problem,
    body: projectData.problem
  },
  {
    id: "role",
    title: detail.role,
    items: projectData.myRole ?? projectData.role ?? [projectData.summary]
  },
  {
    id: "contributions",
    title: detail.contributions,
    items: projectData.keyContributions ?? projectData.contributions ?? projectData.tags.map((tag) => `${tag} based implementation note`)
  },
  {
    id: "troubleshooting",
    title: detail.troubleshooting,
    items: projectData.troubleshooting
  },
  {
    id: "results",
    title: detail.results,
    items: projectData.results
  },
  {
    id: "devops",
    title: detail.devops,
    items: projectData.devops
  },
  {
    id: "public-scope",
    title: detail.privacyNotes,
    items: projectData.privacyNotes
  }
].filter((section) => Boolean(section.body) || Boolean(section.items?.length));

const techStack = projectData.techStack?.length ? projectData.techStack : projectData.tags;
const architecture = projectData.architecture?.length ? projectData.architecture : ["Client", "API", "Service", "Database"];
---

<SiteLayout locale={locale} content={t} title={`${project.title} | Heetae Lee`} description={project.summary}>
  <main class="mx-auto max-w-6xl px-5 py-8 sm:px-6 sm:py-10 lg:px-8">
    <article class="resume-shell rounded-[28px] border border-line-200 bg-white/92 p-5 sm:p-8 lg:p-10">
      <a href={withLocale(locale, "/projects")} class="no-print inline-flex items-center gap-2 text-sm font-extrabold text-ink-500 hover:text-blue-accent">
        <ArrowLeft class="h-4 w-4" />
        {t.common.backToProjects}
      </a>

      <div class="mt-7 grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px]">
        <div>
          <h1 class="text-3xl font-black tracking-tight text-ink-950 sm:text-4xl">{project.title}</h1>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-ink-600">{tag}</span>)}
          </div>

          <div class="mt-7 grid gap-4">
            {
              detailSections.map((section) => (
                <section id={section.id} class="soft-card rounded-3xl p-6 scroll-mt-28">
                  <SectionHeading title={section.title} />
                  {section.body && <p class="text-sm font-medium leading-7 text-ink-600">{section.body}</p>}
                  {
                    section.items && (
                      <ul class="grid gap-2.5 text-sm font-medium leading-7 text-ink-700">
                        {section.items.map((item) => <li class="flex gap-3"><span class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-accent"></span>{item}</li>)}
                      </ul>
                    )
                  }
                </section>
              ))
            }

            <section id="tech-stack" class="soft-card rounded-3xl p-6">
              <SectionHeading title={t.common.techTags} />
              <div class="flex flex-wrap gap-2">
                {techStack.map((tag) => <span class="rounded-full bg-blue-soft px-3 py-1.5 text-xs font-extrabold text-blue-accent">{tag}</span>)}
              </div>
            </section>
          </div>
        </div>

        <aside class="grid content-start gap-4 lg:sticky lg:top-24">
          <section>
            <h2 class="mb-3 text-sm font-extrabold text-ink-950">{detail.architecture}</h2>
            <ArchitectureDiagram nodes={architecture} />
          </section>
          <section class="soft-card rounded-3xl p-5">
            <h2 class="mb-4 text-sm font-extrabold text-ink-950">{detail.screenshots}</h2>
            <div class="rounded-2xl border border-line-200 bg-slate-50 p-3">
              <div class="grid gap-2">
                {Array.from({ length: 7 }).map((_, index) => (
                  <div class="grid grid-cols-[1fr_2fr_1fr] gap-2">
                    <span class="h-3 rounded-full bg-white"></span>
                    <span class="h-3 rounded-full bg-white"></span>
                    <span class:list={["h-3 rounded-full", index % 3 === 0 ? "bg-emerald-200" : "bg-line-200"]}></span>
                  </div>
                ))}
              </div>
            </div>
          </section>
          <nav class="no-print soft-card-flat rounded-3xl p-5 text-sm font-bold text-ink-600" aria-label={t.common.onThisPage}>
            <p class="mb-3 text-xs font-extrabold uppercase text-ink-400">{t.common.onThisPage}</p>
            <div class="grid gap-2">
              {detailSections.map((section) => <a href={`#${section.id}`} class="hover:text-blue-accent">{section.title}</a>)}
              <a href="#tech-stack" class="hover:text-blue-accent">{t.common.techTags}</a>
            </div>
          </nav>
        </aside>
      </div>
    </article>
  </main>
</SiteLayout>
