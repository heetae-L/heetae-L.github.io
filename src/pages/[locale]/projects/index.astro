---
import ProjectCard from "../../../components/ProjectCard.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getContent } from "../../../data";
import { locales, type Locale, withLocale } from "../../../i18n/config";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getContent(locale);

const activeFilterClasses = "border-blue-action bg-blue-action text-white";
const inactiveFilterClasses = "border-line-200 bg-white text-ink-600 hover:border-blue-accent/30 hover:text-blue-accent dark:bg-surface-raised";
---

<SiteLayout locale={locale} content={t} title={`${t.projects.title} | Heetae Lee`} description={t.projects.description}>
  <main class="mx-auto max-w-6xl px-5 py-8 sm:px-6 sm:py-10 lg:px-8">
    <section class="resume-shell rounded-[28px] border border-line-200 bg-white/92 p-5 sm:p-8 lg:p-10 dark:bg-surface">
      <SectionHeading eyebrow={t.projects.eyebrow} title={t.projects.title} description={t.projects.description} />
      <div class="no-print mb-6 flex flex-wrap gap-2">
        {
          t.projects.filters.map((filter, index) => (
            <button
              type="button"
              data-project-filter
              data-filter-key={filter.key}
              aria-pressed={index === 0 ? "true" : "false"}
              class:list={[
                "rounded-xl border px-4 py-2 text-xs font-extrabold transition",
                index === 0 ? activeFilterClasses : inactiveFilterClasses
              ]}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
      <div class="grid gap-4">
        {
          t.projects.items.map((project) => (
            <div data-project-card data-categories={project.categories.join(" ")} data-personal={project.personal ? "true" : undefined}>
              <ProjectCard project={project} href={withLocale(locale, `/projects/${project.slug}`)} variant="wide" />
            </div>
          ))
        }
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll("[data-project-filter]"));
  const projectCards = Array.from(document.querySelectorAll("[data-project-card]"));
  const validFilters = new Set(filterButtons.map((button) => button.getAttribute("data-filter-key")));
  const languageLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-language-switch]"));

  function setButtonState(button: Element, isActive: boolean) {
    button.classList.toggle("border-blue-action", isActive);
    button.classList.toggle("bg-blue-action", isActive);
    button.classList.toggle("text-white", isActive);
    button.classList.toggle("border-line-200", !isActive);
    button.classList.toggle("bg-white", !isActive);
    button.classList.toggle("dark:bg-surface-raised", !isActive);
    button.classList.toggle("text-ink-600", !isActive);
    button.classList.toggle("hover:border-blue-accent/30", !isActive);
    button.classList.toggle("hover:text-blue-accent", !isActive);
    button.setAttribute("aria-pressed", String(isActive));
  }

  function applyProjectFilter(filterKey: string) {
    filterButtons.forEach((button) => {
      setButtonState(button, button.getAttribute("data-filter-key") === filterKey);
    });

    projectCards.forEach((card) => {
      const categories = card.getAttribute("data-categories")?.split(" ") ?? [];
      const shouldShow = filterKey === "all" || (filterKey === "personal" ? card.hasAttribute("data-personal") : categories.includes(filterKey));
      (card as HTMLElement).hidden = !shouldShow;
    });

    languageLinks.forEach((link) => {
      const url = new URL(link.href);
      if (filterKey === "all") url.searchParams.delete("filter");
      else url.searchParams.set("filter", filterKey);
      link.href = `${url.pathname}${url.search}${url.hash}`;
    });
  }

  function restoreProjectFilter() {
    const requested = new URL(window.location.href).searchParams.get("filter");
    applyProjectFilter(requested && validFilters.has(requested) ? requested : "all");
  }

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filterKey = button.getAttribute("data-filter-key") ?? "all";
      const url = new URL(window.location.href);
      if (filterKey === "all") url.searchParams.delete("filter");
      else url.searchParams.set("filter", filterKey);
      if (url.href !== window.location.href) window.history.pushState(null, "", url);
      applyProjectFilter(filterKey);
    });
  });

  window.addEventListener("popstate", restoreProjectFilter);
  restoreProjectFilter();
</script>
