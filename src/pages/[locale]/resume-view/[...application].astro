---
import { readdirSync } from "node:fs";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getContent } from "../../../data";
import { locales, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  const applications = readdirSync("public/downloads", { withFileTypes: true })
    .filter((entry) => entry.isFile())
    .flatMap((entry) => {
      const match = /^heetae-lee-resume_(\d{6}-\d{2})\.html$/.exec(entry.name);
      return match ? [match[1]] : [];
    });

  return locales.flatMap((locale) => [
    { params: { locale, application: undefined } },
    ...applications.map((application) => ({ params: { locale, application } }))
  ]);
}

const locale = Astro.params.locale as Locale;
const application = Astro.params.application;
const resume = `/downloads/heetae-lee-resume${application ? `_${application}` : ""}.html`;
const pdf = "/downloads/heetae-lee-resume.pdf";
---

<SiteLayout locale={locale} content={getContent(locale)} title="Resume | Heetae Lee" noIndex>
  <main class="mx-auto max-w-6xl px-5 py-6 sm:px-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-xl font-extrabold text-ink-900">Resume</h1>
      <div class="flex flex-wrap gap-3 text-sm font-semibold text-blue-accent">
        <a href={resume} target="_blank" rel="noopener noreferrer" data-document-action="open">
          {locale === "ko" ? "HTML 열기" : "Open HTML"}
        </a>
        <a href={pdf} download data-document-action="download">
          {locale === "ko" ? "PDF 다운로드" : "Download PDF"}
        </a>
      </div>
    </div>
    <iframe src={resume} title={locale === "ko" ? "이력서" : "Resume in Korean"} class="h-[75vh] w-full rounded-lg border border-line-200 bg-surface-raised"></iframe>
  </main>
</SiteLayout>
