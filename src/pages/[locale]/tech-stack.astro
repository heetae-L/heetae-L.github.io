---
import SectionHeading from "../../components/SectionHeading.astro";
import TechStackGrid from "../../components/TechStackGrid.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { locales, type Locale } from "../../i18n/config";
import { getContent } from "../../i18n/content";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getContent(locale);
---

<SiteLayout locale={locale} content={t} title={`${t.techStack.title} | Heetae Lee`} description={t.techStack.description}>
  <main class="mx-auto max-w-6xl px-5 py-8 sm:px-6 sm:py-10 lg:px-8">
    <section class="resume-shell rounded-[28px] border border-line-200 bg-white/92 p-5 sm:p-8 lg:p-10">
      <SectionHeading eyebrow={t.techStack.eyebrow} title={t.techStack.title} description={t.techStack.description} />
      <TechStackGrid groups={t.techStack.groups} />
    </section>
  </main>
</SiteLayout>
